{"selfsum": {"sheets": {"Sheet1": {"A1": 1, "A2": 2, "A3": "=SUM(A1:A3)", "B1": "=A3*2", "B2": "=IFERROR(A3,\"cyc\")", "B3": "=ISERROR(A3)"}}}, "two": {"sheets": {"Sheet1": {"A1": "=B1+1", "B1": "=A1+1", "C1": "=A1", "C2": "=IFERROR(B1,-1)", "C3": "=SUM(A1:B1)"}}}, "self": {"sheets": {"Sheet1": {"A1": "=A1+1", "B1": "=A1", "C1": "=IF(A1>0,1,2)"}}}, "three": {"sheets": {"Sheet1": {"A1": "=B1", "B1": "=C1", "C1": "=A1*2", "D1": "=COUNT(A1:C1)", "D2": "=COUNTA(A1:C1)"}}}, "avgself": {"sheets": {"Sheet1": {"A1": 5, "A2": 7, "A3": "=AVERAGE(A1:A4)", "A4": "=A3+1", "B1": "=A4"}}}, "iferrself": {"sheets": {"Sheet1": {"A1": 3, "A2": "=IFERROR(SUM(A1:A3),0)", "A3": "=A2*2", "B1": "=A3"}}}, "maxcol": {"sheets": {"Sheet1": {"A1": 1, "A2": 5, "A3": "=MAX(A:A)", "B1": "=MAX(A1:A2)"}}}, "crosssheet": {"sheets": {"Sheet1": {"A1": "=Other!A1+1"}, "Other": {"A1": "=Sheet1!A1*2", "B1": "=A1"}}}}